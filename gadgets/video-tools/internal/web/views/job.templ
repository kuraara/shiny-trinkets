package views

import (
	"github.com/kuraara/shiny-trinkets/gadgets/video-tools/internal/app"
	"github.com/kuraara/shiny-trinkets/gadgets/video-tools/internal/jobs"
)

templ JobPage(p Page, j jobs.Job, pv *app.PanelView) {
	@Layout(p) {
		<div class="jobhead">
			<div>
				<p class="kind">{ kindLabel(j.Kind) }</p>
				<h1 class="page">{ j.Title }</h1>
			</div>
			<div class="jobactions">
				if j.Status.Active() {
					<button class="btn btn-quiet" hx-post={ "/jobs/" + j.ID + "/cancel" } hx-confirm="Stop this job?">Stop</button>
				}
				<button class="btn btn-quiet" hx-post={ "/jobs/" + j.ID + "/delete" } hx-confirm="Delete this job and its files?">Delete</button>
			</div>
		</div>
		if j.Kind == "join" && len(j.Inputs) > 0 {
			<p class="inputs">
				for i, in := range j.Inputs {
					if i > 0 {
						<span class="sep" aria-hidden="true">+</span>
					}
					<span>{ in.Name } <span class="dim">({ human(in.Size) })</span></span>
				}
			</p>
		}
		if j.Kind == "clip" && len(j.Inputs) > 0 {
			<p class="inputs"><span class="dim">Cut from</span> <span>{ j.Inputs[0].Name }</span></p>
		}
		if j.Status.Active() {
			@JobStatus(j)
		}
		if j.Status == jobs.Failed || j.Status == jobs.Cancelled {
			<div class="flash flash-bad" role="alert">
				if j.Status == jobs.Cancelled {
					<p>This job was stopped.</p>
				} else {
					<p>{ j.Error }</p>
				}
			</div>
			if len(j.Log) > 0 {
				<details class="log">
					<summary>Tool output</summary>
					<pre>
						for _, l := range j.Log {
							{ l + "\n" }
						}
					</pre>
				</details>
			}
		}
		if j.Kind == "panel" && pv != nil {
			@PanelReview(j, *pv)
		}
		if (j.Kind == "join" || j.Kind == "clip") && j.Status == jobs.Done {
			@VideoResult(j)
		}
	}
}

templ JobStatus(j jobs.Job) {
	<div id="job-status" class="status" hx-get={ "/jobs/" + j.ID + "/status" } hx-trigger="every 2s" hx-swap="outerHTML">
		<progress max="100" value={ itoa(j.Progress) } aria-label="Progress"></progress>
		<p><span class="pct">{ itoa(j.Progress) }%</span> { j.Message }</p>
	</div>
}

templ Notes(j jobs.Job) {
	if len(j.Notes) > 0 {
		<ul class="notes">
			for _, n := range j.Notes {
				<li>{ n }</li>
			}
		</ul>
	}
}

// VideoResult shows a finished join or clip: play it here, download it, open it on its own, or
// (on phones) share it to Photos, Messages and so on.
templ VideoResult(j jobs.Job) {
	for _, o := range j.Outputs {
		if o.Kind == "video" {
			<video class="player" controls playsinline preload="metadata" src={ string(fileURL(j.ID, o.Name)) }></video>
			<p class="actions">
				<a class="btn" href={ fileURL(j.ID, o.Name) } download={ o.Name }>Download ({ human(o.Size) })</a>
				<button class="btn btn-quiet" type="button" hidden data-share-file={ string(fileURL(j.ID, o.Name)) } data-share-name={ o.Name }>Share…</button>
				<a class="btn btn-quiet" href={ fileURL(j.ID, o.Name) } target="_blank" rel="noopener">Open on its own</a>
			</p>
			<p class="dim">{ o.Name }</p>
		}
	}
	@Notes(j)
}

templ PanelReview(j jobs.Job, pv app.PanelView) {
	<form id="review" class="review" hx-post={ "/jobs/" + j.ID + "/render" } hx-target="#result" hx-swap="innerHTML" hx-indicator="#render-busy" data-review>
		<section class="strip" aria-label="Preview of the finished image">
			<label class="strip-opt"><input type="checkbox" data-panel-numbers/> Show panel numbers and times</label>
			for fi, f := range pv.Analysis.Frames {
				<figure class="frame">
					<div class="shot">
						<img src={ string(fileURL(j.ID, smallJPEG(f.Image))) } alt={ "Panel " + itoa(fi+1) + ", " + secs(f.T) + " seconds into the clip" } loading="lazy"/>
						<div class="subs" data-subs={ itoa(fi) }>
							for _, l := range linesOnFrame(pv.Review, fi) {
								<p>
									if l.Speaker != "" {
										<b>{ l.Speaker }:</b>
									}
									“{ l.Text }”
								</p>
							}
						</div>
					</div>
					<figcaption hidden>Panel { itoa(fi + 1) } at { secs(f.T) }s</figcaption>
				</figure>
			}
		</section>
		<section class="lines">
			<h2>Who says what</h2>
			<p class="lede">Watch whose mouth moves in each strip of frames, then name the speaker. The preview updates as you type.</p>
			<datalist id="speakers"></datalist>
			for li, l := range pv.Analysis.Lines {
				<fieldset class="line" data-line={ itoa(li) } aria-labelledby={ "lh" + itoa(li) }>
					<h3 class="lh" id={ "lh" + itoa(li) }>Line { itoa(li + 1) } <span class="time">{ secs(l.Start) }–{ secs(l.End) }s</span></h3>
					<button type="button" class="sheet" data-lightbox={ string(fileURL(j.ID, l.ContactSheet)) } aria-label={ "Enlarge the frames for line " + itoa(li+1) }>
						<img src={ string(fileURL(j.ID, smallJPEG(l.ContactSheet))) } alt={ "Eight frames across line " + itoa(li+1) } loading="lazy"/>
					</button>
					<div class="lf">
					<p class="pitch">
						{ pitchText(l.Pitch) }
						if l.Pitch != nil && l.Pitch.Flat {
							<span class="warn"> Suspiciously steady, so probably music or a sound effect. Go by the frames.</span>
						}
					</p>
					<label class="field">
						<span>Speaker</span>
						<input type="text" name="speaker" list="speakers" value={ reviewLine(pv.Review, li).Speaker } autocomplete="off" data-speaker/>
					</label>
					<label class="field">
						<span>Line</span>
						<textarea name="text" rows="2" data-text>{ reviewLine(pv.Review, li).Text }</textarea>
					</label>
					<label class="field">
						<span>Show on</span>
						<select name="frame" data-frame>
							for fi := range pv.Analysis.Frames {
								<option value={ itoa(fi) } selected?={ reviewLine(pv.Review, li).Frame == fi }>Panel { itoa(fi + 1) }</option>
							}
							<option value="-1" selected?={ reviewLine(pv.Review, li).Frame == -1 }>Leave off the image</option>
						</select>
					</label>
					</div>
				</fieldset>
			}
			if len(pv.Analysis.Lines) == 0 {
				<p class="empty">No speech was found, so the panels will have no subtitles.</p>
			}
			@Notes(j)
			<div class="actions sticky">
				<button class="btn" type="submit">Render image</button>
				<span id="render-busy" class="htmx-indicator">Rendering…</span>
			</div>
		</section>
	</form>
	<section id="result" class="result" aria-live="polite">
		if pv.Rendered {
			@PanelResult(j, pv)
		}
	</section>
}

templ PanelResult(j jobs.Job, pv app.PanelView) {
	<h2>Finished image</h2>
	<a href={ fileURL(j.ID, "panel_transcript.png") } target="_blank" rel="noopener">
		<img class="final" src={ string(fileURLv(j.ID, "panel_transcript_sm.jpg", j.Updated)) } alt="The finished panel transcript"/>
	</a>
	<p class="actions">
		for _, o := range j.Outputs {
			<a class={ "btn", templ.KV("btn-quiet", o.Kind != "image") } href={ fileURL(j.ID, o.Name) } download={ o.Name }>{ o.Label }</a>
		}
	</p>
	<table class="transcript">
		<thead><tr><th scope="col">Time</th><th scope="col">Speaker</th><th scope="col">Line</th></tr></thead>
		<tbody>
			for li, l := range pv.Analysis.Lines {
				<tr>
					<td class="num">{ secs(l.Start) }–{ secs(l.End) }s</td>
					<td>{ reviewLine(pv.Review, li).Speaker }</td>
					<td>“{ reviewLine(pv.Review, li).Text }”</td>
				</tr>
			}
		</tbody>
	</table>
}

templ JobsPage(p Page, list []jobs.Job) {
	@Layout(p) {
		<h1 class="page">Jobs</h1>
		<p class="lede">Finished jobs and their files are deleted automatically after the retention period shown on the Status page.</p>
		if len(list) == 0 {
			<p class="empty">No jobs yet.</p>
		} else {
			@JobTable(list)
		}
	}
}
